# Required if you use the gateway backend
MARAS_SWITCHBOARD_GATEWAY_TOKEN=replace-me

# Required only if you use ElevenLabs
MARAS_SWITCHBOARD_ELEVENLABS_API_KEY=replace-me

# Required only if you use xAI STT
XAI_API_KEY=replace-me

# Optional if you use Chatterbox Turbo TTS from a dedicated venv
MARAS_SWITCHBOARD_CHATTERBOX_TURBO_PYTHON_PATH=<chatterbox-repo>/.venv/bin/python
MARAS_SWITCHBOARD_CHATTERBOX_TURBO_VOICE_PROMPT_PATH=<path-to-reference-audio>.wav
